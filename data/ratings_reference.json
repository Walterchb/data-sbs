    {
      "group": "Solvencia",
      "title": "Solvencia mejora, pero sigue por debajo del sistema",
      "source": "PCR / Moody's",
      "as_of": "Dic-2025",
      "text": "RCG 16.4% (Moody's 16.39%) y Tier 1 / APR 11.5% (Moody's 11.54%). Ambas clasificadoras destacan la mejora por capitalización, pero comparan el capital con niveles mayores del sistema.",
      "metric_ids": [
        "rcg",
        "tier1_apr",
        "leverage"
      ]
    },
    {
      "group": "Calidad de activos",
      "title": "Menor mora, con refinanciados como punto de seguimiento",
      "source": "PCR / Moody's",
      "as_of": "Dic-2025",
      "text": "La mora bajó a 3.5% y la cartera problema se ubicó alrededor de 4.9%; PCR señala que mayores refinanciamientos compensaron parte de la mejora de mora.",
      "metric_ids": [
        "overdue_ratio",
        "refi_ratio",
        "car_ratio",
        "real_delinquency"
      ]
    },
    {
      "group": "Cobertura",
      "title": "Cobertura de cartera problema por encima de 100%",
      "source": "PCR / Moody's",
      "as_of": "Dic-2025",
      "text": "PCR reporta cobertura de atrasos de 171.4% y cobertura CAR de 123.0%; Moody's reporta 122.95% para cartera problema y US$55.4 MM de provisiones voluntarias.",
      "metric_ids": [
        "coverage_overdue",
        "coverage_car",
        "provisions_direct"
